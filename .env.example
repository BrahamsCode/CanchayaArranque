# Variables que consume docker-compose.yml (puertos y credenciales de Postgres).
# Copiar a .env antes de `docker compose up` si quieres cambiar los valores por defecto.
DB_DATABASE=canchaya
DB_USERNAME=canchaya
DB_PASSWORD=canchaya
DB_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
